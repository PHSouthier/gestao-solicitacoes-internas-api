# Copie este arquivo para .env e ajuste os valores: cp .env.example .env

# Banco
POSTGRES_DB=solicitacoes
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Rodando a API fora do Docker (npm run start:dev)
DATABASE_URL=postgresql://app:app@localhost:5433/solicitacoes

# Flyway (remova a pasta seed para não carregar dados de exemplo)
FLYWAY_LOCATIONS=filesystem:/flyway/sql,filesystem:/flyway/seed

# API
PORT=3001
JWT_SECRET=troque-este-segredo-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Front-end: para onde o usuário volta depois do login com Google
FRONTEND_URL=http://localhost:3000

# Login com Google (Google Cloud Console → APIs e serviços → Credenciais).
# Vazio = login com Google desligado;
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
LOG_LEVEL=info
